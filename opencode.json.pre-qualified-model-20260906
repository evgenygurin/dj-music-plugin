  "model": "openrouter/z-ai/glm-5-2:free",
  "small_model": "openrouter/openai/gpt-oss-20b:free",
  "plugin": [
    "@mem0/opencode-plugin",
    "opencode-supabase",
    "superpowers@git+https://github.com/obra/superpowers.git",
    "gitnexus-opencode"
  ],
  "mcp": {
    "djmusic": {
      "type": "local",
      "command": [
        "uv",
        "run",
        "--project",
        "/Users/laptop/dev/dj-music-plugin",
        "fastmcp",
        "run",
        "server.py:mcp",
        "--transport",
        "stdio",
        "--no-banner"
      ],
      "timeout": 3600000,
      "enabled": true
    },
    "supabase": {
      "type": "local",
      "command": [
        "bash",
        "-c",
        "cd /Users/laptop/dev/dj-music-plugin && set -a && . .env && set +a && exec ./node_modules/.bin/mcp-server-supabase --read-only --project-ref=bowosphlnghhgaulcyfm --features=database,docs,debug"
      ],
      "timeout": 60000,
      "enabled": true
    },
    "gitnexus": {
      "type": "local",
      "command": [
        "/opt/homebrew/bin/gitnexus",
        "mcp"
      ],
      "enabled": true
    }
  },
  "permission": {
    "gitnexus_query": "allow",
    "gitnexus_context": "allow",
    "gitnexus_impact": "allow",
    "gitnexus_list_repos": "allow",
    "gitnexus_analyze": "allow"
  }
}

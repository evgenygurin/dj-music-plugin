  "computed_notes": {
    "description": "These values are defaults; where possible, compute them dynamically from track features instead of using hardcoded constants.",
    "transition_bars": "Can be computed from phrase boundaries (e.g., default 32 or 48 bars) or overridden manually (0, 16). Use track phrase analysis (`dominant_phrase_bars`, `phrase_boundaries_ms`) to determine actual overlap length.",
    "body_bars": "Can be computed from dominant phrase length (`dominant_phrase_bars`) or set manually (32, 40, 56). For dense mix, shorter body (16-32) may be preferred.",
    "target_bpm": "Fixed at 130.0 for standard techno; for multi-genre sets, compute median/mean BPM from selected `audio_bpm` values, or use `audio_bpm` per track for time-stretch ratios.",
    "bpm_range": "Can be computed from `audio_bpm` and `bpm` fields of selected tracks; audit uses `BpmRangeRule` (120-155) as a gate, not a fixed range.",
    "energy_mean_ideal": "Ideal energy for subgenre profiles; can be derived from `energy_mean` of candidate pool or set manually.",
    "transition_bars_hypnotic": "Deprecated per-subgenre overrides in RenderSettings; use `subgenre_constants.json` presets instead.",
    "transition_length_formula": "Standard blend length = max(32, min(64, dominant_phrase_bars * 2)) bars; for minimal/dub use 64+ bars; for peak-time/hard use 8-16 bars.",
    "body_length_formula": "Body length = max(32, dominant_phrase_bars) for standard; for dense mix use 16-32.",
    "camelot_distance": "Compute using `audio_key_code` or `beatport_camelot`; standard acceptance threshold <= 2 (strict) or <= 3 (soft).",
    "energy_arc_phase": "Compute energy direction (up/down/flat) by comparing `integrated_lufs` or `energy_mean` between consecutive tracks with phase-aware scoring (warmup/build/peak/release).",
    "transition_score_composite": "Use 6-component formula (BPM, harmony, energy, genre, brightness, rhythm) with weights from `audit_rules`; exclude axes with missing data (brightness, rhythm when no Essentia) without penalty."
  }

# Railway runtime for the FastMCP Streamable HTTP server.
# Avoid Debian apt installs in the Railway builder: ffmpeg is supplied by a
# static multi-arch image and soundfile bundles libsndfile in its Python wheel.
FROM --platform=linux/amd64 mwader/static-ffmpeg:7.0.2 AS ffmpeg

FROM --platform=linux/amd64 python:3.12-slim-bookworm

COPY --from=ghcr.io/astral-sh/uv:0.6.6 /uv /uvx /usr/local/bin/
COPY --from=ffmpeg /ffmpeg /usr/local/bin/ffmpeg
COPY --from=ffmpeg /ffprobe /usr/local/bin/ffprobe

ENV UV_LINK_MODE=copy \
    UV_COMPILE_BYTECODE=1 \
    UV_PYTHON_DOWNLOADS=never \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PATH="/app/.venv/bin:$PATH"

WORKDIR /app
COPY pyproject.toml README.md ./
RUN uv sync --no-install-project --extra audio --extra postgres

COPY app ./app
COPY server.py fastmcp.json ./
RUN uv sync --extra audio --extra postgres

EXPOSE 8080
CMD ["fastmcp", "run", "server.py:mcp", "--transport", "streamable-http", "--host", "0.0.0.0", "--port", "8080", "--path", "/mcp", "--log-level", "INFO"]

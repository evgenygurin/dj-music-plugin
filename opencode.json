{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "AGENTS.md"
  ],
  "skills": {
    "paths": [
      ".opencode/skills",
      "skills"
    ]
  },
  "agent": {
    "dj-music": {
      "description": "DJ techno music specialist — manages library, builds sets, analyzes audio transitions, works with Yandex Music/Beatport/Suno. Triggers on: dj, set, mix, track, bpm, camelot, transition, playlist, library, techno, suno, yandex music, beatport, stem_transition_policy, demucs, 5-stem, policy, electronic.",
      "mode": "subagent",
      "model": "claude-sonnet-4-6"
    },
    "ym-api-specialist": {
      "description": "Yandex Music API specialist — debug provider_read/write/search, investigate 429/403/400 errors, trace YM API quirks.",
      "mode": "subagent",
      "color": "warning"
    }
  },
  "plugin": [],
  "mcp": {
    "djmusic": {
      "type": "local",
      "command": [
        "uv",
        "run",
        "--project",
        "/Users/laptop/dev/dj-music-plugin",
        "fastmcp",
        "run",
        "server.py:mcp",
        "--transport",
        "stdio",
        "--no-banner"
      ],
      "timeout": 3600000,
      "enabled": true
    },
    "supabase": {
      "type": "local",
      "command": [
        "bash",
        "-c",
        "cd /Users/laptop/dev/dj-music-plugin && set -a && . .env && set +a && exec ./node_modules/.bin/mcp-server-supabase --read-only --project-ref=bowosphlnghhgaulcyfm --features=database,docs,debug"
      ],
      "timeout": 60000,
      "enabled": true
    },
    "gitnexus": {
      "type": "local",
      "command": [
        "/opt/homebrew/bin/gitnexus",
        "mcp"
      ],
      "enabled": true
    }
  },
  "permission": {
    "gitnexus_query": "allow",
    "gitnexus_context": "allow",
    "gitnexus_impact": "allow",
    "gitnexus_list_repos": "allow",
    "gitnexus_analyze": "allow"
  }
}
